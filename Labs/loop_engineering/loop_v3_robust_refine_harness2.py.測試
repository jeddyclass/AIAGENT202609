class DetailedTestResult(unittest.TestResult):
    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        self.test_reports = []

    def addSuccess(self, test):
        super().addSuccess(test)
        self.test_reports.append((test._testMethodName, "PASSED", test.shortDescription(), ""))

    def addFailure(self, test, err):
        super().addFailure(test, err)
        self.test_reports.append((test._testMethodName, "FAILED", test.shortDescription(), self._exc_info_to_string(err, test)))

    def addError(self, test, err):
        super().addError(test, err)
        self.test_reports.append((test._testMethodName, "ERROR", test.shortDescription(), self._exc_info_to_string(err, test)))

def evaluate_code(candidate_code: str):
    namespace = {}
    try:
        exec(candidate_code, namespace)
    except Exception as e:
        return False, [], f"編譯失敗: {type(e).__name__}: {str(e)}"

    if "TTLCache" not in namespace:
        return False, [], "代碼中未找到 TTLCache 類別！"

    try:
        exec(TEST_SUITE_CODE, namespace)
    except Exception as e:
        return False, [], f"測試注入失敗: {str(e)}"

    suite = unittest.TestSuite()
    loader = unittest.TestLoader()
    suite.addTests(loader.loadTestsFromTestCase(namespace["TestTTLCache"]))

    collector = DetailedTestResult()
    suite.run(collector)
    return collector.wasSuccessful(), collector.test_reports, ""

def extract_code(raw: str) -> str:
    # 支援 ```python 或被截斷但已有 class 的字串
    matches = re.findall(r"```(?:python)?\s*(.*?)\s*```", raw, re.DOTALL)
    if matches:
        return matches[-1].strip()
    if "class TTLCache" in raw:
        return raw.replace("```python", "").replace("```", "").strip()
    return raw.strip()

def run_fixed_loop(max_iterations: int = 15):
    system_prompt = (
        "You are an expert Systems Engineer. Complete the implementation of TTLCache based on OrderedDict.\n"
        "CRITICAL RULES:\n"
        "1. DO NOT change method names or arguments. Keep exact signatures:\n"
        "   - __init__(self, capacity: int, default_ttl: float = 60.0)\n"
        "   - get(self, key)\n"
        "   - put(self, key, value, ttl: float = None)\n"
        "   - resize(self, new_capacity: int)\n"
        "   - size(self) -> int\n"
        "2. Do NOT write comments, docstrings, or markdown explanations. Every token must be pure code to prevent truncation.\n"
        "3. Wrap the entire class inside a single ```python ``` block."
    )

    current_code = INTERFACE_SKELETON
    messages = [
        {"role": "system", "content": system_prompt},
        {
            "role": "user",
            "content": f"Implement the complete, working TTLCache class:\n\n```python\n{INTERFACE_SKELETON}\n```\nIt must pass all LRU ordering, TTL cleanup, and resize requirements."
        }
    ]

    for attempt in range(1, max_iterations + 1):
        print(f"\n{'='*25} [Loop 迭代 {attempt}/{max_iterations}] {'='*25}")
        print(f"🤖 呼叫 {MODEL_NAME} 產出/修復代碼...")

        response = client.chat.completions.create(
            model=MODEL_NAME,
            messages=messages,
            temperature=0.1,
            max_tokens=2500,  # 調高以避免生成中途被截斷
        )
        raw_output = response.choices[0].message.content.strip()
        candidate = extract_code(raw_output)

        is_passed, reports, err = evaluate_code(candidate)

        if err:
            print(f"💥 語法/執行異常: {err}")
            feedback = f"Execution failed:\n{err}\nOutput the full class inside ```python ``` with correct syntax."
        else:
            print("\n📋【單元測試執行看板】")
            for name, status, _, _ in reports:
                print(f"  {'✅ 通過' if status == 'PASSED' else '❌ 失敗'} | {name}")

            if is_passed:
                print(f"\n🎉 [終止條件達成] 12B 模型在第 {attempt} 輪全數通過所有測試！")
                return candidate

            # 抓取關鍵失敗原因回傳
            failed_reasons = [f"- {r[0]}: {r[3].strip().splitlines()[-1]}" for r in reports if r[1] != "PASSED"]
            feedback = "The following tests failed:\n" + "\n".join(failed_reasons) + "\n\nFix the logic while keeping EXACT method signatures."

        # 滑動窗口回饋
        messages = [
            {"role": "system", "content": system_prompt},
            {"role": "user", "content": f"Your previous code:\n```python\n{candidate}\n```\n\n{feedback}\nPlease provide the complete, corrected class in ```python ```."}
        ]

    print("\n⚠️ 達到最大迭代上限。")
    return None

if __name__ == "__main__":
